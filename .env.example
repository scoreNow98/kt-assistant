# Copy to .env on the server and fill in. Never commit .env.
# Passwords: letters and digits only (they go into a database URL). Make each with: openssl rand -hex 24

DOMAIN=kt.example.com
DB_PASSWORD=
APP_DB_PASSWORD=

# Any OpenAI-compatible model API. For Ollama on the same server (--profile local-models):
#   LLM_BASE_URL=http://ollama:11434/v1   LLM_API_KEY=ollama   EMBED_MODEL=bge-m3   CHAT_MODEL=gemma3:4b
# Changing EMBED_MODEL later means loading the documents again.
LLM_BASE_URL=
LLM_API_KEY=
EMBED_MODEL=
CHAT_MODEL=

# Optional: a Slack, Google Chat or Discord incoming webhook for error alerts.
ALERT_WEBHOOK_URL=
